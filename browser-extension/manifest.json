{
  "manifest_version": 3,
  "name": "拾忆 · 划词收藏",
  "version": "0.2.9",
  "description": "划词或收藏网页到拾忆：写入你的 WebDAV 云盘（坚果云等），桌面与移动端自动同步成复习卡。",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾忆 · 划词收藏"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}