{
  "manifest_version": 3,
  "name": "Glean · 划词收藏",
  "version": "0.3.0",
  "description": "划词或收藏网页到 Glean：写入你的 WebDAV 云盘（坚果云等），桌面与移动端自动合并进收件箱。",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glean · 划词收藏"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}